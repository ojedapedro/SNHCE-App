# =============================================================================
# SNHCE - Sistema Nacional de Historia Clínica Electrónica
# Archivo de variables de entorno de ejemplo
# =============================================================================
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env
#   2. Reemplazar los valores de ejemplo con los valores reales de tu ambiente
#   3. NUNCA subir el archivo .env al repositorio (está en .gitignore)
#   4. En producción, las variables sensibles deben provenir de HashiCorp Vault
#      o del gestor de secretos de la plataforma cloud correspondiente.
# =============================================================================

# -----------------------------------------------------------------------------
# POSTGRESQL - Base de datos relacional principal
# -----------------------------------------------------------------------------

# Nombre de la base de datos principal de la aplicación
POSTGRES_DB=snhce_dev

# Usuario administrador de PostgreSQL
POSTGRES_USER=snhce_user

# Contraseña del usuario de PostgreSQL
# EN PRODUCCIÓN: mínimo 32 caracteres aleatorios, gestionar desde Vault
POSTGRES_PASSWORD=Dev_Snhce_2024!

# URL de conexión completa para la instancia primaria (lectura/escritura)
DATABASE_URL=postgresql://snhce_user:Dev_Snhce_2024!@localhost:5432/snhce_dev

# Nombre de la base de datos de Keycloak (creada en el mismo servidor PostgreSQL)
KEYCLOAK_DB=keycloak

# URL de conexión a la réplica de solo lectura (para reportes y consultas analíticas)
POSTGRES_REPLICA_URL=postgresql://snhce_user:Dev_Snhce_2024!@localhost:5433/snhce_dev

# -----------------------------------------------------------------------------
# REDIS - Caché distribuida, sesiones y colas de mensajes
# -----------------------------------------------------------------------------

# Contraseña de autenticación de Redis
# EN PRODUCCIÓN: mínimo 32 caracteres aleatorios
REDIS_PASSWORD=RedisSnhce_Dev2024!

# URL de conexión completa a Redis
REDIS_URL=redis://:RedisSnhce_Dev2024!@localhost:6379

# -----------------------------------------------------------------------------
# MINIO - Almacenamiento de objetos (documentos clínicos e imágenes)
# -----------------------------------------------------------------------------

# Usuario raíz de MinIO (equivalente al Access Key)
MINIO_ROOT_USER=snhce-minio-admin

# Contraseña raíz de MinIO (equivalente al Secret Key)
# EN PRODUCCIÓN: mínimo 16 caracteres
MINIO_ROOT_PASSWORD=MinioSnhce_Dev2024!

# Endpoint de conexión a MinIO desde el backend
MINIO_ENDPOINT=http://localhost:9000

# Nombre del bucket para documentos clínicos cifrados en reposo
MINIO_BUCKET_DOCUMENTS=snhce-documents

# Nombre del bucket para resultados de laboratorio e imágenes diagnósticas
MINIO_BUCKET_RESULTS=snhce-results

# Nombre del bucket para respaldos de la base de datos
MINIO_BUCKET_BACKUPS=snhce-backups

# Región del bucket (se usa 'us-east-1' como valor por defecto de MinIO)
MINIO_REGION=us-east-1

# -----------------------------------------------------------------------------
# KEYCLOAK - Servidor de Identidad y Acceso (IAM / SSO)
# -----------------------------------------------------------------------------

# Nombre del usuario administrador de Keycloak
KEYCLOAK_ADMIN=admin

# Contraseña del administrador de Keycloak
# EN PRODUCCIÓN: gestionar desde Vault, nunca en texto plano
KEYCLOAK_ADMIN_PASSWORD=KeycloakAdmin_Dev2024!

# URL base del servidor Keycloak (accesible desde el backend)
KEYCLOAK_URL=http://localhost:8080

# Nombre del realm de SNHCE en Keycloak
KEYCLOAK_REALM=snhce

# ID del cliente confidencial del backend en Keycloak
KEYCLOAK_CLIENT_ID=snhce-backend

# Secreto del cliente confidencial del backend
# EN PRODUCCIÓN: generar desde la consola de Keycloak y almacenar en Vault
KEYCLOAK_CLIENT_SECRET=change-me-in-keycloak-console-dev-secret

# URL del endpoint JWKS para verificación de tokens JWT emitidos por Keycloak
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/snhce/protocol/openid-connect/certs

# URL del endpoint de OpenID Connect para descubrimiento automático
KEYCLOAK_ISSUER=http://localhost:8080/realms/snhce

# -----------------------------------------------------------------------------
# HASHICORP VAULT - Gestión centralizada de secretos
# -----------------------------------------------------------------------------

# Dirección del servidor Vault
VAULT_ADDR=http://localhost:8200

# Token raíz de desarrollo de Vault
# ADVERTENCIA: Solo para desarrollo local. EN PRODUCCIÓN usar AppRole o AWS IAM
VAULT_DEV_ROOT_TOKEN_ID=snhce-vault-dev-root-token

# Token de acceso usado por el backend para leer secretos
# En desarrollo, se usa el root token. En producción, usar token de AppRole
VAULT_TOKEN=snhce-vault-dev-root-token

# -----------------------------------------------------------------------------
# JWT - Tokens de acceso (respaldo, el principal viene de Keycloak)
# -----------------------------------------------------------------------------

# Clave secreta para firmar JWT internos del backend
# EN PRODUCCIÓN: este valor DEBE provenir de Vault (ruta: snhce/jwt)
# Mínimo 64 caracteres hexadecimales aleatorios
JWT_SECRET=dev-jwt-secret-change-me-in-production-use-vault-minimum-64-chars-hex

# Tiempo de expiración del access token en segundos (5 minutos)
JWT_ACCESS_EXPIRY=300

# Tiempo de expiración del refresh token en segundos (8 horas)
JWT_REFRESH_EXPIRY=28800

# -----------------------------------------------------------------------------
# SERVIDOR BACKEND
# -----------------------------------------------------------------------------

# Puerto en el que escucha el servidor NestJS
BACKEND_PORT=3000

# Ambiente de ejecución del Node.js
# Valores posibles: development | staging | production
NODE_ENV=development

# Nivel de verbosidad de los logs
# Valores posibles: error | warn | info | debug | verbose
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# CORREO ELECTRÓNICO (SMTP)
# En desarrollo apunta a MailDev. En producción usar servidor SMTP real.
# -----------------------------------------------------------------------------

# Host del servidor SMTP
SMTP_HOST=localhost

# Puerto del servidor SMTP (1025 para MailDev en desarrollo)
SMTP_PORT=1025

# Usuario de autenticación SMTP (vacío en MailDev)
SMTP_USER=

# Contraseña de autenticación SMTP (vacía en MailDev)
SMTP_PASSWORD=

# Dirección del remitente para los correos del sistema
SMTP_FROM=no-reply@snhce.gob.ve

# Nombre visible del remitente en los correos
SMTP_FROM_NAME=SNHCE Sistema Nacional

# Habilitar TLS para SMTP (false en desarrollo con MailDev)
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# URLs DE LAS APLICACIONES FRONTEND
# -----------------------------------------------------------------------------

# URL del portal del paciente
FRONTEND_URL=http://localhost:5173

# URL del panel de administración del sistema
ADMIN_URL=http://localhost:5174

# URL de la aplicación clínica (médicos y personal de salud)
CLINICA_URL=http://localhost:5175

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# -----------------------------------------------------------------------------
# SEGURIDAD Y CIFRADO
# -----------------------------------------------------------------------------

# Emisor para las aplicaciones de autenticación de dos factores (TOTP)
# Aparece en la app Google Authenticator / Aegis como nombre de cuenta
MFA_ISSUER=SNHCE-Dev

# ID de la clave maestra usada para cifrado de sobre (envelope encryption)
# La clave real reside en Vault en la ruta snhce/encryption-keys
ENCRYPTION_KEY_ID=snhce-dev-key-v1

# Número de rondas para bcrypt (hash de contraseñas locales si aplica)
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# ADAPTADORES DE SERVICIOS EXTERNOS
# En desarrollo se usan simuladores para no depender de servicios reales.
# En producción cambiar a los adaptadores de integración real.
# -----------------------------------------------------------------------------

# Adaptador para consulta al SAIME (Servicio Administrativo de Identificación)
# Valores posibles: simulator | rest-api
SAIME_ADAPTER=simulator

# URL del servicio SAIME (solo en producción)
SAIME_API_URL=

# Token de autenticación API del SAIME (solo en producción)
SAIME_API_TOKEN=

# Adaptador para firma electrónica de documentos clínicos
# Valores posibles: simulator | pkcs11 | xades
FIRMA_ELECTRONICA_ADAPTER=simulator

# Adaptador para envío de mensajes SMS (notificaciones y MFA)
# Valores posibles: simulator | movistar-ve | digitel-ve | twilio
SMS_ADAPTER=simulator

# Credenciales del proveedor SMS (solo en producción)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=SNHCE

# -----------------------------------------------------------------------------
# SERVICIOS DE FARMACOLOGÍA
# -----------------------------------------------------------------------------

# URL base de la API RxNorm (NLMNIH) para información de medicamentos
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# URL del catálogo de medicamentos venezolano (INVIMA VE / MPPS)
MPPS_MEDICAMENTOS_URL=

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE NODO (para nodos locales de establecimientos de salud)
# -----------------------------------------------------------------------------

# Indica si esta instancia es un nodo local (relay) o el servidor central
LOCAL_NODE=false

# ID único del establecimiento de salud para este nodo (si LOCAL_NODE=true)
ESTABLECIMIENTO_ID=

# URL del servidor central para sincronización (si LOCAL_NODE=true)
CENTRAL_NODE_URL=

# Token de autenticación con el nodo central (si LOCAL_NODE=true)
CENTRAL_NODE_TOKEN=
