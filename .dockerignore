# ============================================================
# .dockerignore — excluye del contexto Docker todo lo que
# NO necesita el backend para compilarse.
# Contexto: raíz del monorepo (context: .)
#
# REGLA CLAVE: pnpm workspace necesita los package.json de
# TODOS los workspace members para resolver el grafo de deps,
# incluso cuando se usa --filter. Por eso NO excluimos
# apps/*/package.json ni packages/*/package.json.
# Solo excluimos el código fuente y artefactos.
# ============================================================

# --- Código fuente de apps frontend (NO necesario en build Docker) ---
apps/*/src/
apps/*/public/
apps/*/dist/
apps/*/node_modules/
apps/*/.turbo/
apps/*/coverage/
apps/*/build/

# --- Código fuente de paquetes compartidos ---
packages/*/src/
packages/*/dist/
packages/*/node_modules/
packages/*/.turbo/

# --- node_modules raíz (se instalan dentro del contenedor) ---
node_modules/
backend/node_modules/

# --- Artefactos de build y cobertura ---
**/coverage/
**/.turbo/

# --- Backend: dist local (se genera dentro del contenedor) ---
backend/dist/

# --- Archivos de entorno secretos ---
.env
.env.local
.env.*.local

# --- Archivos de test (no necesarios para compilar) ---
backend/test/
**/*.e2e-spec.ts

# --- Logs ---
**/logs/
**/*.log
npm-debug.log*

# --- Git ---
.git/
.gitignore
.gitattributes

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Turborepo cache ---
.turbo/

# --- Infraestructura (no necesaria para build del backend) ---
infrastructure/
docs/
